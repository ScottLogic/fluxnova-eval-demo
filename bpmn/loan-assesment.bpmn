<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:agent="http://fluxnova.finos.org/schema/1.0/ai/agent" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" id="Definitions_AgenticSubprocessExample" targetNamespace="http://fluxnova.finos.org/examples/agentic-subprocess" exporter="Fluxnova Modeler" exporterVersion="1.3.0-dev" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="3.0.0">
  <process id="loanAssessmentProcess" name="Loan Application Assessment" isExecutable="true" camunda:historyTimeToLive="180">
    <startEvent id="StartEvent_ApplicationReceived" name="Loan Application&#10;Received">
      <outgoing>Flow_Start_To_Validate</outgoing>
    </startEvent>
    <adHocSubProcess id="AdHocSubProcess_LoanAssessmentAgent" name="Loan Assessment Agent" ordering="Parallel" cancelRemainingInstances="false">
      <documentation>AI agent responsible for assessing a loan application end-to-end. The agent must gather credit, employment, fraud, and collateral data before generating a structured assessment report with a clear APPROVE or REJECT recommendation.</documentation>
      <extensionElements>
        <agent:config provider="openai" model="gpt-4o" systemPrompt="You are a senior loan assessment analyst. Your goal is to gather enough evidence to make a well-reasoned, defensible lending decision for each applicant. You MUST complete ALL required checks before stopping, even if an early result is unfavorable. Execute in rounds: (1) Call Run Fraud Screening and Check Credit Score together in the SAME tool-calling response; these checks are independent and must not consume separate rounds. (2) For EMPLOYED applicants, run Verify Employment; for SELF_EMPLOYED applicants, run Analyse Bank Statements instead. If hasCollateral is true, also run Value Collateral, preferably in this same round. Never value collateral when hasCollateral is false. (3) Run Assess Affordability only after the income-verification tool has completed. (4) Once all required tool results are available, provide your final response without an extra planning-only turn or repeated checks. A separate collateral round is allowed if needed. The target is at most four total LLM calls including the final answer, or five with a separate collateral round. EVERY tool call MUST include its named arguments from the process context: Run Fraud Screening(applicationId, customerId); Check Credit Score(customerId); Verify Employment(customerId); Analyse Bank Statements(customerId); Value Collateral(applicationId); Assess Affordability(customerId, requestedAmount). Copy the exact applicationId and customerId, and pass requestedAmount as its numeric context value. Never send an empty argument object, omit required arguments, or invent identifiers. Supply these arguments through the tool-calling mechanism even when the engine also binds process variables. Your final response must first summarize the actual evidence: credit score/risk band, fraud risk score, verified income and employment or bank-statement result, DTI and affordability outcome, and collateral value when applicable. Do not invent missing values or risk-policy thresholds. Then give a concise justification explicitly connecting those values to the selected decision, for example rejecting because affordability failed and DTI is high, or approving because verified income, affordability and risk checks support repayment. Finish with a NEW final line containing EXACTLY APPROVE or REJECT, with no markdown, punctuation, or text after it. Select one decision; vague conclusions or deferring it to a human/next steps are not acceptable. Do NOT embed tool calls as JSON text in your response — always use the tool-calling mechanism. A separate step will compile the final report." />
        <agent:context>
          <agent:variable name="applicationId" />
          <agent:variable name="customerId" />
          <agent:variable name="applicantName" />
          <agent:variable name="requestedAmount" />
          <agent:variable name="applicantType" />
          <agent:variable name="hasCollateral" />
          <agent:variable name="collateralDescription" />
          <agent:variable name="loanPurpose" />
          <agent:variable name="creditScore" />
          <agent:variable name="creditRiskBand" />
          <agent:variable name="employmentVerified" />
          <agent:variable name="annualIncome" />
          <agent:variable name="bankStatementScore" />
          <agent:variable name="fraudRiskScore" />
          <agent:variable name="collateralValue" />
          <agent:variable name="debtToIncomeRatio" />
          <agent:variable name="affordabilityPassed" />
        </agent:context>
      </extensionElements>
      <incoming>Flow_Start_To_Validate</incoming>
      <outgoing>Flow_0s3blcw</outgoing>
      <serviceTask id="ServiceTask_CreditScoreCheck" name="Check Credit Score" camunda:type="external" camunda:topic="credit-score-check">
        <documentation>Retrieves the applicant's current credit score from the credit bureau.         Returns a numeric score (300–850) and a risk band: LOW, MEDIUM, or HIGH.</documentation>
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="customerId">${customerId}</camunda:inputParameter>
            <camunda:outputParameter name="creditScore">${creditScore}</camunda:outputParameter>
            <camunda:outputParameter name="creditRiskBand">${creditRiskBand}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </serviceTask>
      <serviceTask id="ServiceTask_VerifyEmployment" name="Verify Employment" camunda:type="external" camunda:topic="employment-verification">
        <documentation>Verifies the applicant's current employment status with their stated employer.
Returns employmentVerified (true/false) and confirmed annualIncome in GBP.</documentation>
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="customerId">${customerId}</camunda:inputParameter>
            <camunda:outputParameter name="employmentVerified">${employmentVerified}</camunda:outputParameter>
            <camunda:outputParameter name="annualIncome">${annualIncome}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </serviceTask>
      <serviceTask id="ServiceTask_BankStatementAnalysis" name="Analyse Bank Statements" camunda:type="external" camunda:topic="bank-statement-analysis">
        <documentation>Analyses 12 months of bank statements to confirm income for a self-employed or variable-income applicant. Returns bankStatementScore (0-100, higher is better) and annualIncome in GBP derived from average monthly deposits.</documentation>
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="customerId">${customerId}</camunda:inputParameter>
            <camunda:outputParameter name="bankStatementScore">${bankStatementScore}</camunda:outputParameter>
            <camunda:outputParameter name="annualIncome">${annualIncome}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </serviceTask>
      <serviceTask id="ServiceTask_FraudScreening" name="Run Fraud Screening" camunda:type="external" camunda:topic="fraud-screening">
        <documentation>Screens the application and applicant against known fraud patterns and watchlists. Returns fraudRiskScore (0–100); higher scores indicate greater risk.</documentation>
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="applicationId">${applicationId}</camunda:inputParameter>
            <camunda:inputParameter name="customerId">${customerId}</camunda:inputParameter>
            <camunda:outputParameter name="fraudRiskScore">${fraudRiskScore}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </serviceTask>
      <serviceTask id="ServiceTask_CollateralValuation" name="Value Collateral" camunda:type="external" camunda:topic="collateral-valuation">
        <documentation>Retrieves a current independent market valuation for any collateral offered against the loan. Returns collateralValue in GBP.
        </documentation>
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="applicationId">${applicationId}</camunda:inputParameter>
            <camunda:outputParameter name="collateralValue">${collateralValue}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </serviceTask>
      <serviceTask id="ServiceTask_AffordabilityAssessment" name="Assess Affordability" camunda:type="external" camunda:topic="affordability-assessment">
        <documentation>Calculates whether the applicant can afford the requested loan based on their confirmed income and existing financial commitments. Returns debtToIncomeRatio (0.0–1.0) and affordabilityPassed (true/false).
        </documentation>
        <extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="customerId">${customerId}</camunda:inputParameter>
            <camunda:inputParameter name="requestedAmount">${requestedAmount}</camunda:inputParameter>
            <camunda:outputParameter name="debtToIncomeRatio">${debtToIncomeRatio}</camunda:outputParameter>
            <camunda:outputParameter name="affordabilityPassed">${affordabilityPassed}</camunda:outputParameter>
          </camunda:inputOutput>
        </extensionElements>
      </serviceTask>
      <completionCondition>${false}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="Flow_Start_To_Validate" sourceRef="StartEvent_ApplicationReceived" targetRef="AdHocSubProcess_LoanAssessmentAgent" />
    <endEvent id="EndEvent_ApplicationComplete" name="Process End Event">
      <incoming>Flow_0s3blcw</incoming>
    </endEvent>
    <sequenceFlow id="Flow_0s3blcw" sourceRef="AdHocSubProcess_LoanAssessmentAgent" targetRef="EndEvent_ApplicationComplete" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loanAssessmentProcess">
      <bpmndi:BPMNShape id="Shape_StartEvent" bpmnElement="StartEvent_ApplicationReceived">
        <dc:Bounds x="182" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="295" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AdHocSubProcess" bpmnElement="AdHocSubProcess_LoanAssessmentAgent" isExpanded="true">
        <dc:Bounds x="320" y="80" width="600" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CreditScoreCheck" bpmnElement="ServiceTask_CreditScoreCheck">
        <dc:Bounds x="360" y="125" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_VerifyEmployment" bpmnElement="ServiceTask_VerifyEmployment">
        <dc:Bounds x="500" y="125" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BankStatementAnalysis" bpmnElement="ServiceTask_BankStatementAnalysis">
        <dc:Bounds x="640" y="125" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_FraudScreening" bpmnElement="ServiceTask_FraudScreening">
        <dc:Bounds x="780" y="125" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CollateralValuation" bpmnElement="ServiceTask_CollateralValuation">
        <dc:Bounds x="470" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AffordabilityAssessment" bpmnElement="ServiceTask_AffordabilityAssessment">
        <dc:Bounds x="610" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0nzj1sd_di" bpmnElement="EndEvent_ApplicationComplete">
        <dc:Bounds x="1042" y="257" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1029" y="300" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Start_To_Validate" bpmnElement="Flow_Start_To_Validate">
        <di:waypoint x="218" y="270" />
        <di:waypoint x="320" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0s3blcw_di" bpmnElement="Flow_0s3blcw">
        <di:waypoint x="920" y="275" />
        <di:waypoint x="1042" y="275" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
