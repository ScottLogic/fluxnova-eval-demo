# Copy this file to .env and adjust the values below as needed for your local setup.
# .env is gitignored (it holds secrets like OPENAI_API_KEY) — this example file is the
# one tracked in git.
#
# The Fluxnova image is published (publicly) to GitHub Container Registry (GHCR) — no
# login needed to pull it. See local-dev/README.md's "Fluxnova image" section for how
# to build/push a new version from the source repo.

# Image (and tag) to run for the Fluxnova engine.
FLUXNOVA_IMAGE=ghcr.io/dogle-scottlogic/fluxnova-edd-platform:1.2.0

# Host port to expose the Fluxnova engine REST API on (matches fluxnova_url in
# the runner's workflow config files, e.g. http://localhost:8080/engine-rest).
FLUXNOVA_PORT=8080

# API key for the BPMN agent's OpenAI provider (see default.yml's spring.ai.model.chat)
# AND for the regression suite's LLM-as-judge scorers (see
# fluxnova_mlflow_dataset.scorers.LLM_JUDGE_PROVIDER, which defaults to "openai" and is
# read directly by litellm/MLflow — no separate key var). Only required while at least one
# of those is set to "openai" — leave blank if you've switched both back to "ollama".
OPENAI_API_KEY=

# Which provider the regression suite's LLM-as-judge scorers use (decision_quality,
# matches_golden, evidence_citation — see fluxnova_mlflow_dataset.scorers). Defaults to
# "openai" (model gpt-4o-mini — deliberately different from the BPMN agent's gpt-4o, to
# avoid a same-model self-preference bias when judging). Set to "ollama" to judge fully
# locally instead (model gemma4:e2b) — no OPENAI_API_KEY needed in that case.
LLM_JUDGE_PROVIDER=openai

# MLflow tracking-server image. Pinned to exactly match the mlflow client version the
# eval services depend on (mlflow[genai]==3.16.0) — keep server/client in lockstep so
# their DB schema (alembic) heads never drift (a mismatch makes the regression suite's
# direct-Postgres client reject the store — see local-dev/services/mlflow-up.sh's
# `mlflow db upgrade` prestep and regression/conftest.py).
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.16.0

# OTel Collector image (defaults to the upstream contrib distribution, which
# includes the otlphttp exporter used to reach MLflow). Pinned for reproducibility.
OTEL_COLLECTOR_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.160.0

# Observability stack (observability-up.sh: Prometheus + Grafana in the
# observability-local pod). Prometheus scrapes the OTel Collector's Prometheus exporter
# (fluxnova-local:8889) and Grafana dashboards the gen_ai.* metrics — see
# local-dev/README.md's "GenAI observability dashboard" section.
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.14.0
GRAFANA_IMAGE=docker.io/grafana/grafana:13.2.1
# Host ports the observability pod is published on.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# PostgreSQL image/port used by postgres-up.sh — the shared backing database for both
# MLflow's tracking-server backend store and Fluxnova's process-engine datasource
# (replacing their previous SQLite/H2 file-based defaults). Start this pod before
# mlflow-up.sh / fluxnova-up.sh. See local-dev/README.md's "PostgreSQL database" section.
POSTGRES_IMAGE=docker.io/library/postgres:16
POSTGRES_PORT=5432

# PostgreSQL credentials — all consumed as env vars (never hardcoded) by
# postgres-up.sh (creates these roles/databases via postgres/init.sh),
# mlflow-up.sh (MLflow's --backend-store-uri), and fluxnova-up.sh (passed through to
# default.yml's spring.datasource via ${VAR} placeholders). Change these before the
# first ./postgres-up.sh run — they're baked into the database on creation; if you
# change them afterwards, either remove the postgres-local-data volume to
# re-initialise, or update the passwords in Postgres directly
# (ALTER USER ... WITH PASSWORD ...).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow
MLFLOW_POSTGRES_DB=mlflow

FLUXNOVA_POSTGRES_USER=fluxnova
FLUXNOVA_POSTGRES_PASSWORD=fluxnova
FLUXNOVA_POSTGRES_DB=fluxnova

# Numeric MLflow experiment ID traces get sent to — MLflow's OTLP endpoint requires
# this on every request, and ALL traces (parent eval process + called agent child
# process) are routed here regardless of process key. Must already exist (the eval
# services create experiments automatically on first use);
MLFLOW_EXPERIMENT_ID=1

# MLflow experiment NAME the eval-service-worker READS agent traces from. This must
# name the SAME experiment MLFLOW_EXPERIMENT_ID (above) points at, since that's where
# the OTel collector writes traces consumed by both eval-service-up.sh and compose.yaml (the eval-service-worker).
EVAL_SERVICE_EXPERIMENT_NAME=fluxnova-loanAssessmentEvalProcess
