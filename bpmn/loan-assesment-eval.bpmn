<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:agent="http://fluxnova.finos.org/schema/1.0/ai/agent" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" id="Definitions_AgenticSubprocessExample" targetNamespace="http://fluxnova.finos.org/examples/agentic-subprocess" exporter="Fluxnova Modeler" exporterVersion="1.3.0-dev" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="3.0.0">
  <process id="loanAssessmentEvalProcess" name="Loan Application Assessment (Eval)" isExecutable="true" camunda:historyTimeToLive="180">
    <startEvent id="StartEvent_ApplicationReceived" name="Loan Application&#10;Received">
      <outgoing>Flow_Start_To_Validate</outgoing>
    </startEvent>
    <callActivity id="CallActivity_LoanAssessmentAgent" name="Loan Assessment Agent" calledElement="loanAssessmentProcess">
      <extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </extensionElements>
      <incoming>Flow_Start_To_Validate</incoming>
      <outgoing>Flow_0s3blcw</outgoing>
    </callActivity>
    <sequenceFlow id="Flow_Start_To_Validate" sourceRef="StartEvent_ApplicationReceived" targetRef="CallActivity_LoanAssessmentAgent" />
    <serviceTask id="ServiceTask_EvaluateAgentOutput" name="Evaluate Agent Output" camunda:type="external" camunda:topic="agent-output-eval">
      <documentation>Scores the just-completed agent run against the decision_quality MLflow judge (see eval-service-worker/ and EVAL-SERVICE-WORKER-PLAN.md). Reads trace data only — no input variables needed. Sets evalPassed (Boolean) and evalRationale (String) process variables used by the following gateway.</documentation>
      <incoming>Flow_0s3blcw</incoming>
      <outgoing>Flow_Eval_ToGateway</outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_EvalPassed" name="Eval Passed?" default="Flow_Eval_Failed">
      <incoming>Flow_Eval_ToGateway</incoming>
      <outgoing>Flow_Eval_Passed</outgoing>
      <outgoing>Flow_Eval_Failed</outgoing>
    </exclusiveGateway>
    <userTask id="UserTask_ReviewFailedEval" name="Review Failed Evaluation" camunda:candidateGroups="loan-officers">
      <documentation>The automated evaluation did not pass. A loan officer must manually review the agent's assessment (see evalRationale) before the application is allowed to progress.</documentation>
      <incoming>Flow_Eval_Failed</incoming>
      <outgoing>Flow_ReviewFailed_To_Report</outgoing>
    </userTask>
    <serviceTask id="ServiceTask_GenerateReport" name="Generate Assessment Report" camunda:type="external" camunda:topic="generate-assessment-report">
      <documentation>Compiles all gathered assessment data into a structured report and sets recommendedDecision to APPROVE or REJECT.</documentation>
      <incoming>Flow_Eval_Passed</incoming>
      <incoming>Flow_ReviewFailed_To_Report</incoming>
      <outgoing>Flow_Report_To_Gateway</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_AssessmentDecision" name="Recommendation?">
      <incoming>Flow_Report_To_Gateway</incoming>
      <outgoing>Flow_Gateway_To_Approve</outgoing>
      <outgoing>Flow_Gateway_To_Reject</outgoing>
    </exclusiveGateway>
    <userTask id="UserTask_ApprovalReview" name="Review and Approve Loan" camunda:candidateGroups="loan-officers">
      <incoming>Flow_Gateway_To_Approve</incoming>
      <outgoing>Flow_Approve_To_End</outgoing>
    </userTask>
    <serviceTask id="ServiceTask_RejectNotification" name="Send Rejection Notice" camunda:type="external" camunda:topic="rejection-notification">
      <incoming>Flow_Gateway_To_Reject</incoming>
      <outgoing>Flow_Reject_To_End</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_LoanApproved" name="Loan Approved">
      <incoming>Flow_Approve_To_End</incoming>
    </endEvent>
    <endEvent id="EndEvent_LoanRejected" name="Loan Rejected">
      <incoming>Flow_Reject_To_End</incoming>
    </endEvent>
    <sequenceFlow id="Flow_0s3blcw" sourceRef="CallActivity_LoanAssessmentAgent" targetRef="ServiceTask_EvaluateAgentOutput" />
    <sequenceFlow id="Flow_Eval_ToGateway" sourceRef="ServiceTask_EvaluateAgentOutput" targetRef="ExclusiveGateway_EvalPassed" />
    <sequenceFlow id="Flow_Eval_Passed" name="Yes" sourceRef="ExclusiveGateway_EvalPassed" targetRef="ServiceTask_GenerateReport">
      <conditionExpression xsi:type="tFormalExpression">${evalPassed == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Eval_Failed" name="No" sourceRef="ExclusiveGateway_EvalPassed" targetRef="UserTask_ReviewFailedEval" />
    <sequenceFlow id="Flow_ReviewFailed_To_Report" sourceRef="UserTask_ReviewFailedEval" targetRef="ServiceTask_GenerateReport" />
    <sequenceFlow id="Flow_Report_To_Gateway" sourceRef="ServiceTask_GenerateReport" targetRef="Gateway_AssessmentDecision" />
    <sequenceFlow id="Flow_Gateway_To_Approve" name="APPROVE" sourceRef="Gateway_AssessmentDecision" targetRef="UserTask_ApprovalReview">
      <conditionExpression xsi:type="tFormalExpression">${recommendedDecision == 'APPROVE'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Gateway_To_Reject" name="REJECT" sourceRef="Gateway_AssessmentDecision" targetRef="ServiceTask_RejectNotification">
      <conditionExpression xsi:type="tFormalExpression">${recommendedDecision == 'REJECT'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Approve_To_End" sourceRef="UserTask_ApprovalReview" targetRef="EndEvent_LoanApproved" />
    <sequenceFlow id="Flow_Reject_To_End" sourceRef="ServiceTask_RejectNotification" targetRef="EndEvent_LoanRejected" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loanAssessmentEvalProcess">
      <bpmndi:BPMNShape id="Shape_StartEvent" bpmnElement="StartEvent_ApplicationReceived">
        <dc:Bounds x="152" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="295" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CallActivity_LoanAssessmentAgent" bpmnElement="CallActivity_LoanAssessmentAgent">
        <dc:Bounds x="250" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EvaluateAgentOutput" bpmnElement="ServiceTask_EvaluateAgentOutput">
        <dc:Bounds x="410" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ExclusiveGateway_EvalPassed" bpmnElement="ExclusiveGateway_EvalPassed" isMarkerVisible="true">
        <dc:Bounds x="575" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="563" y="215" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReviewFailedEval" bpmnElement="UserTask_ReviewFailedEval">
        <dc:Bounds x="550" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GenerateReport" bpmnElement="ServiceTask_GenerateReport">
        <dc:Bounds x="700" y="230" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_AssessmentDecision" bpmnElement="Gateway_AssessmentDecision" isMarkerVisible="true">
        <dc:Bounds x="920" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="903" y="302" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ApprovalReview" bpmnElement="UserTask_ApprovalReview">
        <dc:Bounds x="1050" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RejectNotification" bpmnElement="ServiceTask_RejectNotification">
        <dc:Bounds x="1050" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndApproved" bpmnElement="EndEvent_LoanApproved">
        <dc:Bounds x="1222" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1204" y="215" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndRejected" bpmnElement="EndEvent_LoanRejected">
        <dc:Bounds x="1222" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1204" y="385" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Start_To_Validate" bpmnElement="Flow_Start_To_Validate">
        <di:waypoint x="188" y="270" />
        <di:waypoint x="250" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0s3blcw_di" bpmnElement="Flow_0s3blcw">
        <di:waypoint x="350" y="270" />
        <di:waypoint x="410" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Eval_ToGateway_di" bpmnElement="Flow_Eval_ToGateway">
        <di:waypoint x="510" y="270" />
        <di:waypoint x="575" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Eval_Passed_di" bpmnElement="Flow_Eval_Passed">
        <di:waypoint x="625" y="270" />
        <di:waypoint x="700" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="650" y="252" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Eval_Failed_di" bpmnElement="Flow_Eval_Failed">
        <di:waypoint x="600" y="295" />
        <di:waypoint x="600" y="400" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="608" y="340" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReviewFailed_To_Report_di" bpmnElement="Flow_ReviewFailed_To_Report">
        <di:waypoint x="650" y="440" />
        <di:waypoint x="780" y="440" />
        <di:waypoint x="780" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Report_To_Gateway_di" bpmnElement="Flow_Report_To_Gateway">
        <di:waypoint x="860" y="270" />
        <di:waypoint x="920" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_To_Approve_di" bpmnElement="Flow_Gateway_To_Approve">
        <di:waypoint x="945" y="245" />
        <di:waypoint x="945" y="190" />
        <di:waypoint x="1050" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="958" y="202" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_To_Reject_di" bpmnElement="Flow_Gateway_To_Reject">
        <di:waypoint x="945" y="295" />
        <di:waypoint x="945" y="360" />
        <di:waypoint x="1050" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="958" y="330" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approve_To_End_di" bpmnElement="Flow_Approve_To_End">
        <di:waypoint x="1150" y="190" />
        <di:waypoint x="1222" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_To_End_di" bpmnElement="Flow_Reject_To_End">
        <di:waypoint x="1150" y="360" />
        <di:waypoint x="1222" y="360" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
