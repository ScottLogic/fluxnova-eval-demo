# Adjust the values below as needed for your local setup.
#
# The Fluxnova image is published (publicly) to GitHub Container Registry (GHCR) — no
# login needed to pull it. See local-dev/README.md's "Fluxnova image" section for how
# to build/push a new version from the source repo.

# Image (and tag) to run for the Fluxnova engine.
FLUXNOVA_IMAGE=ghcr.io/dogle-scottlogic/fluxnova-edd-platform:1.0.0

# Host port to expose the Fluxnova engine REST API on (matches fluxnova_url in
# harness config files, e.g. http://localhost:8080/engine-rest).
FLUXNOVA_PORT=8080

# OTel Collector image (defaults to the upstream contrib distribution, which
# includes the otlphttp exporter used to reach MLflow).
OTEL_COLLECTOR_IMAGE=docker.io/otel/opentelemetry-collector-contrib:latest

# Numeric MLflow experiment ID traces get sent to — MLflow's OTLP endpoint requires
# this on every request. Must already exist (mlflow-eval creates it automatically
# on first --collect); look it up with:
#   curl -s http://localhost:5000/api/2.0/mlflow/experiments/search -H "Content-Type: application/json" -d "{\"max_results\": 50}"
# Currently pointed at "fluxnova-loanAssessmentEvalProcess" (id=4) for testing the
# eval-service-worker flow via loan-assesment-eval.bpmn — switch back to 1
# ("fluxnova-loanAssessmentProcess") to record traces for the original loan-assesment.bpmn.
MLFLOW_EXPERIMENT_ID=4
